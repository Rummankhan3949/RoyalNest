rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is admin (hardcoded admin emails)
    function userDocExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdminByRole() {
      return userDocExists() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdminByEmail() {
      return isSignedIn() &&
        request.auth.token.email is string && (
          request.auth.token.email.matches('(?i)^admin17@gmail\\.com$') ||
          request.auth.token.email.matches('(?i)^admin@royalnest\\.com$') ||
          request.auth.token.email.matches('(?i)^admin@gmail\\.com$') ||
          request.auth.token.email.matches('(?i)^superadmin@royalnest\\.com$')
        );
    }

    function isAdmin() {
      return isSignedIn() && (
        isAdminByRole() ||
        isAdminByEmail()
      );
    }

    function isActiveUser() {
      // Keep app usable for authenticated users even if user profile flags are
      // missing or temporarily inconsistent; block handling is enforced in app logic.
      return isSignedIn();
    }

    function isPaymentOwner() {
      return isSignedIn() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
    }

    function isCreatingOwnPayment() {
      return isSignedIn() && (
        request.resource.data.user_id == request.auth.uid ||
        request.resource.data.clientId == request.auth.uid
      );
    }

    function isLostFoundOwner() {
      return isSignedIn() && resource.data.reportedById == request.auth.uid;
    }
    
    // Users collection - enhanced permissions
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isActiveUser() && (isOwner(userId) || isAdmin());
      allow update: if (isActiveUser() && isOwner(userId)) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Societies collection - admin can write, all can read
    match /societies/{societyId} {
      allow read: if isActiveUser();
      allow write: if isActiveUser(); // Allow all authenticated users for flexibility
    }
    
    // Plots collection - admin manages, clients can read their own
    match /plots/{plotId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isActiveUser(); // Allow all for admin operations
      allow list: if isActiveUser(); // Allow listing with queries
    }
    
    // Queries collection - clients create, admin manages
    match /queries/{queryId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if isActiveUser(); // Allow admin to update responses
      allow list: if isActiveUser(); // Enable querying
    }
    
    // Appointments collection - clients book, admin manages
    match /appointments/{appointmentId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if isActiveUser(); // Allow admin to confirm/cancel
      allow list: if isActiveUser(); // Enable filtering by status
    }
    
    // Payments collection - admin creates, clients view
    match /payments/{paymentId} {
      allow read: if (isActiveUser() && isPaymentOwner()) || isAdmin();
      allow create: if (isActiveUser() && isCreatingOwnPayment()) || isAdmin();
      allow update: if (isActiveUser() && isPaymentOwner()) || isAdmin();
      allow delete: if isAdmin();
      allow list: if isActiveUser() || isAdmin();
    }

    // Installments tracker collection
    match /installments/{installmentId} {
      allow read: if isActiveUser() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow create, update, delete: if isAdmin();
      allow list: if isActiveUser() || isAdmin();
    }

    // Reminder logs for duplicate prevention
    match /installment_reminder_logs/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow create, update, delete: if isSignedIn() && isAdmin();
      allow list: if isSignedIn() && isAdmin();
    }

    // Payment methods collection - admin manages, all authenticated users can read
    match /payment_methods/{methodId} {
      allow read, list: if isActiveUser() || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    // Documents collection - clients submit, admin verifies
    match /documents/{documentId} {
      allow read: if isActiveUser() || isAdmin();
      allow create: if isActiveUser();
      allow update: if isActiveUser() || isAdmin(); // Allow admin to update status
      allow delete: if isAdmin();
      allow list: if isActiveUser() || isAdmin(); // Enable document queries
    }
    
    function isLostFoundClaimFlagUpdate() {
      return isActiveUser() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'hasClaimRequest'
        ]) &&
        request.resource.data.hasClaimRequest == true;
    }

    // Lost & Found collection - controlled updates for claim lifecycle
    match /lost_found/{itemId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update: if isAdmin() ||
        isLostFoundOwner() ||
        isLostFoundClaimFlagUpdate();
      allow delete: if isAdmin() || isLostFoundOwner();
      allow list: if isActiveUser(); // Enable filtering
    }

    // Claim requests for Lost & Found ownership verification
    match /claims/{claimId} {
      allow read, list: if isActiveUser();

      // Claimant can only create claim for another user's item.
      allow create: if isActiveUser() &&
        request.resource.data.claimantUserId == request.auth.uid &&
        request.resource.data.ownerUserId != request.auth.uid;

      // Owner or admin can review/update claim status.
      allow update: if isActiveUser() && (
        resource.data.ownerUserId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }
    
    // Notifications collection - all authenticated users can read and write
    match /notifications/{notificationId} {
      allow read: if isActiveUser() || isAdmin();
      allow create, update, delete: if isActiveUser() || isAdmin();
      allow list: if isActiveUser() || isAdmin(); // Enable notification queries
    }

    // Event management: admins can write, active users can read.
    match /events/{eventId} {
      allow read, list: if isActiveUser() || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
