rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is admin (hardcoded admin emails)
    function isAdminByRole() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdmin() {
      return isSignedIn() && (
        isAdminByRole() ||
        request.auth.token.email == 'admin17@gmail.com' ||
        request.auth.token.email == 'admin@royalnest.com' ||
        request.auth.token.email == 'admin@gmail.com' ||
        request.auth.token.email == 'superadmin@royalnest.com'
      );
    }

    function isPaymentOwner() {
      return isSignedIn() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
    }

    function isCreatingOwnPayment() {
      return isSignedIn() && (
        request.resource.data.user_id == request.auth.uid ||
        request.resource.data.clientId == request.auth.uid
      );
    }
    
    // Users collection - enhanced permissions
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isSignedIn() && isAdmin();
    }
    
    // Societies collection - admin can write, all can read
    match /societies/{societyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Allow all authenticated users for flexibility
    }
    
    // Plots collection - admin manages, clients can read their own
    match /plots/{plotId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn(); // Allow all for admin operations
      allow list: if isSignedIn(); // Allow listing with queries
    }
    
    // Queries collection - clients create, admin manages
    match /queries/{queryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn(); // Allow admin to update responses
      allow list: if isSignedIn(); // Enable querying
    }
    
    // Appointments collection - clients book, admin manages
    match /appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn(); // Allow admin to confirm/cancel
      allow list: if isSignedIn(); // Enable filtering by status
    }
    
    // Payments collection - admin creates, clients view
    match /payments/{paymentId} {
      allow read: if isAdmin() || isPaymentOwner();
      allow create: if isCreatingOwnPayment() || isAdmin();
      allow update: if isAdmin() || isPaymentOwner();
      allow delete: if isAdmin();
      allow list: if isSignedIn();
    }

    // Installments tracker collection
    match /installments/{installmentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow create, update, delete: if isAdmin();
      allow list: if isSignedIn();
    }

    // Reminder logs for duplicate prevention
    match /installment_reminder_logs/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow create, update, delete: if isSignedIn() && isAdmin();
      allow list: if isSignedIn() && isAdmin();
    }

    // Payment methods collection - admin manages, all authenticated users can read
    match /payment_methods/{methodId} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    
    // Documents collection - clients submit, admin verifies
    match /documents/{documentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // Allow admin to update status
      allow delete: if isSignedIn() && isAdmin();
      allow list: if isSignedIn(); // Enable document queries
    }
    
    // Lost & Found collection - all authenticated users can read and write
    match /lost_found/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn(); // Allow status updates
      allow list: if isSignedIn(); // Enable filtering
    }
    
    // Notifications collection - all authenticated users can read and write
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
      allow list: if isSignedIn(); // Enable notification queries
    }
  }
}
